# Astroloh - Пример конфигурации Sentry
# Скопируйте эти настройки в ваш .env файл

# === SENTRY МОНИТОРИНГ ===
# Реальный DSN для проекта Astroloh
SENTRY_DSN=https://9edc4d4c9259247c023c4b0e63c8b8ec@o490495.ingest.us.sentry.io/4509820321202176

# Среда выполнения (development, staging, production)
SENTRY_ENVIRONMENT=development

# Версия релиза (например, git commit hash или version)
SENTRY_RELEASE=1.0.0

# Процент трейсов для мониторинга производительности (0.0 - 1.0)
# Рекомендуется: 0.1 для production, 1.0 для development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Процент профилей для анализа производительности (0.0 - 1.0)  
# Рекомендуется: 0.1 для production, 0.5 для development
SENTRY_PROFILES_SAMPLE_RATE=0.1

# === НАСТРОЙКИ SENTRY ДЛЯ РАЗЛИЧНЫХ СРЕД ===

# Development - максимальная информация для отладки
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=0.5

# Staging - умеренное количество данных
# SENTRY_ENVIRONMENT=staging  
# SENTRY_TRACES_SAMPLE_RATE=0.3
# SENTRY_PROFILES_SAMPLE_RATE=0.2

# Production - минимальный overhead, критические ошибки
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# === ИНСТРУКЦИИ ПО НАСТРОЙКЕ SENTRY ===

# 1. Создайте аккаунт на https://sentry.io
# 2. Создайте новый проект Python/FastAPI
# 3. Скопируйте DSN из настроек проекта
# 4. Укажите SENTRY_DSN в .env файле
# 5. Настройте алерты в веб-интерфейсе Sentry
# 6. Добавьте интеграции (Slack, email, etc.)

# === ОСОБЕННОСТИ ДЛЯ ASTROLOH ===

# Sentry автоматически фильтрует чувствительные данные:
# - Астрологические данные (время/место рождения)
# - API ключи и токены
# - Персональную информацию пользователей
# - Сессионные данные Yandex Alice

# Поддерживаемые интеграции:
# - FastAPI (автоматическое отслеживание запросов)
# - Yandex GPT API (мониторинг внешних запросов)
# - PostgreSQL (отслеживание SQL запросов)
# - Redis (мониторинг кэширования)
# - Kerykeion (астрологические расчеты)
# - Alice webhook (диалоговые интерфейсы)

# Кастомные метрики для астрологии:
# - Время генерации гороскопов
# - Использование AI vs традиционных методов
# - Статистика по знакам зодиака
# - Производительность Kerykeion расчетов
# - Успешность обработки Alice запросов

# === ПРИМЕР ПРОДУКЦИОННЫХ НАСТРОЕК ===
# SENTRY_DSN=https://abcd1234@o123456.ingest.sentry.io/123456789
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=v1.2.3
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# === DOCKER КОНФИГУРАЦИЯ ===
# В docker-compose.yml добавьте:
# environment:
#   - SENTRY_DSN=${SENTRY_DSN}
#   - SENTRY_ENVIRONMENT=production
#   - SENTRY_RELEASE=${SENTRY_RELEASE:-latest}